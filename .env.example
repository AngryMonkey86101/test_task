# Токен Telegram-бота от @BotFather (обязателен для python -m novichok bot)
TELEGRAM_BOT_TOKEN=

# ИИ-помощник через DeepSeek (ключ: platform.deepseek.com → API keys)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Или через Claude (если указаны оба ключа, используется DeepSeek; переключить: LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Необязательно: настоящие задачи в Битрикс24 (входящий вебхук с правом «Задачи»)
# BITRIX_WEBHOOK_URL=https://ваш-портал.bitrix24.ru/rest/1/xxxxxxxxxxxx

# Необязательно: chat_id сотрудников HR через запятую (узнать — команда /myid в боте)
# HR_CHAT_IDS=
